MANAGEMENT_PRIVATE_IP=10.10.0.11
DRAC_CENTRAL_IMAGE_TAG=local

# Em produção, use referências por digest (imagem@sha256:...), nunca latest.
CENTRAL_POSTGRES_IMAGE=postgres:16-alpine
MANAGEMENT_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:latest

CENTRAL_POSTGRES_USER=drac_central
CENTRAL_POSTGRES_PASSWORD=change-me
CENTRAL_POSTGRES_DB=drac_central
CENTRAL_DATA_DIR=/opt/ajustcam-management/data/central

DRAC_CENTRAL_ENROLLMENT_TOKEN=change-me
DRAC_CENTRAL_SECRET_KEY=change-me
DRAC_CENTRAL_ARCHIVE_KEY=change-me
CENTRAL_STORAGE_SECRET=change-me
DRAC_CENTRAL_ADMIN_EMAIL=admin@drac.local
DRAC_CENTRAL_ADMIN_PASSWORD_HASH=change-me
DRAC_CENTRAL_ADMIN_TOKEN=
DRAC_CENTRAL_ALLOWED_ORIGINS=https://central.s2cam.com.br
DRAC_CENTRAL_TRUSTED_PROXIES=172.16.0.0/12
DRAC_CENTRAL_PUBLIC_URL=https://central.s2cam.com.br
DRAC_CENTRAL_INSTALLER_COMMIT=40-hex-commit
DRAC_CENTRAL_INSTALLER_SHA256=64-hex-sha256
DRAC_CENTRAL_STORE_MODE=dual

APP_BUILDER_AGENT_URL=
APP_BUILDER_AGENT_TOKEN=
APK_SOURCE_BASE=http://central-ingress:8080

# Automação de push Android por cliente. A conta de serviço fica FORA do Git,
# no diretório apontado abaixo, com permissão 0700 e arquivo 0600.
# Quando configurada, a Central cria o pacote Android no projeto Firebase e
# entrega o google-services.json diretamente ao agente de build.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_DIR=/opt/ajustcam-management/secrets/firebase
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase/service-account.json

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
BACKUP_INTERVAL_SECONDS=604800
BACKUP_RETENTION_DAYS=30
