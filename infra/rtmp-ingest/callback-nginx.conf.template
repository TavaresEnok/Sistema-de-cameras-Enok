server {
    listen 8080;
    server_name _;

    location = /health {
        # Saúde real da ponte: não basta o nginx estar vivo se a API que decide
        # a publicação estiver indisponível.
        proxy_pass http://api:3000/health;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location = /on-publish {
        proxy_pass http://api:3000/camera-stream/srs-publish?internalToken=${CALLBACK_TOKEN};
        proxy_http_version 1.1;
        proxy_set_header Content-Type application/json;
        proxy_connect_timeout 2s;
        proxy_send_timeout 3s;
        proxy_read_timeout 3s;
    }

    location / {
        return 404;
    }
}
