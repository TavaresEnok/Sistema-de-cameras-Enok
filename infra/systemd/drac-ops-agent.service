[Unit]
Description=AjustCam Central operations agent
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=DRAC_OPS_CONFIG_FILE=/etc/drac/ops-agent.env
ExecStart=/opt/drac/scripts/drac-ops-agent.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/log/drac /opt/drac /etc/drac

