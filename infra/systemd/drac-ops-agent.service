[Unit]
Description=AjustCam Central operations agent
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=DRAC_OPS_CONFIG_FILE=/etc/drac/ops-agent.env
ExecStart=/opt/drac/scripts/drac-ops-agent.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# Não declarar /var/log/drac em ReadWritePaths: systemd prepara esses mounts
# antes de o script criar o diretório, e uma instalação limpa falharia com
# status=226/NAMESPACE. ProtectSystem=full já preserva /var gravável; o agente
# cria /var/log/drac com modo 700 ao iniciar.
